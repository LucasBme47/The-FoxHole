# Copy to /etc/pihole-exporter.env on the Pi and fill in the password:
#   sudo install -m 600 -o root -g root pihole-exporter.env.example /etc/pihole-exporter.env
#   sudo nano /etc/pihole-exporter.env
# NEVER commit the filled-in file.

PIHOLE_PROTOCOL=http
PIHOLE_HOSTNAME=127.0.0.1
PIHOLE_PORT=8080

# A Pi-hole "app password" (created in Pi-hole's web settings), not your login password
PIHOLE_PASSWORD="YOUR_PIHOLE_APP_PASSWORD"
