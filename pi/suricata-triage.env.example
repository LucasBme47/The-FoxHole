# Copy to /etc/suricata-triage.env on the Pi and fill in your own values:
#   sudo install -m 600 -o root -g root suricata-triage.env.example /etc/suricata-triage.env
#   sudo nano /etc/suricata-triage.env
# NEVER commit the filled-in file.

# Gmail account that SENDS the alerts, and a Google "app password" for it
SMTP_USER=YOUR_SENDING_ADDRESS@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD

# Where the alerts are delivered
ALERT_EMAIL=YOUR_ALERT_ADDRESS@example.com

# API key from https://www.abuseipdb.com (the free plan allows 1000 lookups a day)
ABUSEIPDB_KEY=YOUR_ABUSEIPDB_API_KEY
